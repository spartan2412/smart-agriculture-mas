# Copy this file to .env and set only the backend you intend to use.
# .env is ignored by Git; do not commit API keys.

# LLM backend: ollama (local), groq, openai, or anthropic
LLM_BACKEND=ollama

# Ollama: install the Ollama desktop app separately, then run
# `ollama pull qwen2.5:7b-instruct`.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# MLX-LM (optional E3 experiment on Apple Silicon). This must be an explicitly
# bound, local model directory; leave blank unless running the E3 protocol.
MLX_MODEL_PATH=

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional services
WEATHER_PROVIDER=open-meteo
NASS_API_KEY=
NASS_COMMODITY=
NASS_STATE=

# Optional LLM retry tuning
LLM_MAX_RETRIES=4
LLM_RETRY_BACKOFF_BASE_S=3

# Current benchmark MAS: set true to make eight bounded LLM calls per scenario
# (Weather, Soil, Satellite/NDVI, Market, Fertilizer Baseline, Official RAG,
# Coordinator, and Farmer Explanation). The model can prioritize only
# immutable pre-approved fact IDs; it cannot change source scope, citations,
# gates, or action status.
BENCHMARK_LLM_ENABLED=true
# Set true for formal runs that must stop if the configured backend is unavailable.
BENCHMARK_LLM_REQUIRED=true
BENCHMARK_LLM_MAX_SELECTED_FACTS=3

# data.gov.in Variety-wise Daily Market Prices API (optional; free authorised key)
DATA_GOV_IN_API_KEY=
